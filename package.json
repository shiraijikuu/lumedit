{
  "name": "lumedit",
  "version": "0.5.0",
  "build": 7,
  "private": true,
  "description": "LumEdit 光影轻修 - 纯本地单张精修桌面工具（裁剪/调色/LUT/保真导出）",
  "author": "LumEdit",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:smoke": "esbuild test/smoke/smoke.ts --bundle --format=esm --loader:.cube=text --outfile=test/smoke/smoke.bundle.js",
    "smoke": "npm run build:smoke && electron test/smoke/smoke-main.cjs",
    "dist": "node scripts/dist.mjs",
    "dist:check": "node scripts/check-asar.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  }
}
